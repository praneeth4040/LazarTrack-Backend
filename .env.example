# ─────────────────────────────────────────────────────────────────────────────
# LazarTrack Backend .env template
# Copy to `.env` (gitignored) and fill in real values. On Render, set these
# in the dashboard — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
PROJECT_NAME="LazarTrack Backend"

# OpenRouter API key for vision-language inference (Qwen etc.)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Video processing workspace
VIDEO_OUTPUT_DIR=video/output

# ── Supabase ─────────────────────────────────────────────────────────────────
# LazarTrack project URL + publishable (anon) key. Used for token verification
# (remote fallback + JWKS) and Storage uploads.
SUPABASE_CLIENT_URL=https://bmvyrkulrlfjdzxirlvd.supabase.co
SUPABASE_CLIENT_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-side only: service-role key for Storage uploads and matches.assets_url
# updates. NEVER expose this to clients.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# Optional: legacy JWT secret (Settings → API → JWT Secret) for local HS256
# token verification. When unset, tokens are verified via the project's JWKS
# endpoint with a fallback to /auth/v1/user.
SUPABASE_JWT_SECRET=

# ── Auth / CORS hardening ────────────────────────────────────────────────────
# How long a verified token is trusted without re-verification (seconds).
AUTH_CACHE_TTL_SECONDS=300

# Comma-separated browser origins allowed to call this API ("*" to allow all —
# local testing only). Defaults to the production web origins + localhost.
# ALLOWED_ORIGINS=https://lazartrack.app,https://app.lazartrack.app

# Optional extra regex for preview deployments. Empty string disables it.
# ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# Host suffixes the server may fetch user-supplied asset URLs from (SSRF guard).
# Empty string disables the restriction (not recommended).
# ALLOWED_ASSET_HOSTS=.supabase.co
